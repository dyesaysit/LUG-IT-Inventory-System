{
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@school-it-inventory/shared/*": ["../shared/*"]
    }
  },
  "ts-node": {
    "files": true
  },
  "exclude": ["src/tests"]
}
